{
  "name": "Observatorio turistico de Colima (tablero)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "tablero/streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user --require-hashes -r tablero/requirements.lock.txt && echo 'Dependencias del tablero instaladas desde el bloqueo con hashes'",
  "postAttachCommand": {
    "server": "streamlit run tablero/streamlit_app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
