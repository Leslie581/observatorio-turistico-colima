# Copiar a .env (NO se versiona). En GitHub Actions: Settings > Secrets and variables > Actions.
# Token gratuito de INEGI (DENUE): https://www.inegi.org.mx/app/api/denue/tokenVerify/tokenverify.html
# En GitHub va como SECRETO del repositorio llamado INEGI_TOKEN.
INEGI_TOKEN=
# Contacto que aparece en el User-Agent del extractor (correo del equipo). En GitHub: variable TDL_CONTACTO.
TDL_CONTACTO=correo-del-equipo@ejemplo.mx
# Opcional: habilita pruebas de integracion con red (requiere INEGI_TOKEN)
TDL_RED=0
